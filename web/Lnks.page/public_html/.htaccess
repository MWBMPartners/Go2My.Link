# =============================================================================
# Go2My.Link — .htaccess for Lnks.page (Component C — LinksPage)
# =============================================================================
#
# Handles: HTTPS enforcement, security headers, slug routing.
# All non-file requests are treated as user/org slugs and routed to index.php.
#
# Examples:
#   lnks.page/username   → index.php?slug=username
#   lnks.page/orgname    → index.php?slug=orgname
#
# @package    Go2My.Link
# @subpackage Configuration
# @author     MWBM Partners Ltd (MWservices)
# @version    0.1.0
# @since      Phase 0
# =============================================================================

# =============================================================================
# Enable Rewrite Engine
# =============================================================================
RewriteEngine On

# =============================================================================
# HTTPS Enforcement
# =============================================================================
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# =============================================================================
# Security Headers
# =============================================================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Content Security Policy
    # LinksPage (Component C) is a PUBLIC render surface for third-party-
    # authored content (page title/bio, item links, social links, theme
    # colours — see web/Lnks.page/_functions/linkspage_renderer.php). Every
    # page this component serves (the "coming soon" homepage, the branded
    # 404, and the rendered LinksPage itself) is fully self-contained —
    # no CDN scripts/stylesheets — so the policy below intentionally has NO
    # third-party origins, unlike the other two components. Theme/background
    # colours are injected into a <style> block (never an inline `style=`
    # attribute driven by unvalidated data — see hex validation in
    # linkspage_renderer.php), so 'unsafe-inline' is scoped to style-src only;
    # script-src stays 'self' with no 'unsafe-inline' since this component
    # ships no inline scripts at all. object-src is 'none' (no plugins/embeds
    # of any kind), closing the classic Flash/Java CSP bypass vector.
    #
    # 🧨 Component C.6 (#49): `Header setifempty` (NOT `Header set`) so a
    # LinksPage rendering owner-supplied CUSTOM HTML can serve an even STRICTER
    # per-response policy (script-src 'none' — see index.php Step 9.5 and
    # g2ml_linkspageCustomHtmlCSP()) set from PHP WITHOUT this baseline
    # clobbering it. setifempty applies this baseline ONLY when PHP has not
    # already set a CSP, so no other page is weakened — the coming-soon
    # homepage, the 404, and system-template pages still receive this baseline.
    # 📖 Reference: https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP
    Header setifempty Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

    # HSTS — enforce HTTPS for 1 year
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# =============================================================================
# Block Private Directories
# =============================================================================
RewriteRule ^_auth_keys(/|$) - [F,L]
RewriteRule ^_includes(/|$) - [F,L]
RewriteRule ^_functions(/|$) - [F,L]
RewriteRule ^_libraries(/|$) - [F,L]
RewriteRule ^_uploads(/|$) - [F,L]
RewriteRule ^_backups(/|$) - [F,L]
RewriteRule ^_sql(/|$) - [F,L]
RewriteRule ^_schemas(/|$) - [F,L]

# =============================================================================
# Block Sensitive Files
# =============================================================================
<FilesMatch "\.(env|log|sql|bak|old|ini|sh|conf|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# =============================================================================
# Directory Listing Protection
# =============================================================================
Options -Indexes

# =============================================================================
# Slug Routing
# Routes all non-file/non-directory requests as LinksPage slugs.
#
# Examples:
#   lnks.page/johndoe     → index.php?slug=johndoe
#   lnks.page/mycompany   → index.php?slug=mycompany
# =============================================================================

# Allow direct access to static files
RewriteRule ^(robots\.txt|favicon\.ico|sitemap\.xml)$ - [L]

# Clean URLs — .php extension removal
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Route everything else as a slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ index.php?slug=$1 [QSA,L]

# =============================================================================
# Character Encoding
# =============================================================================
AddDefaultCharset UTF-8

# =============================================================================
# PHP Configuration
# =============================================================================
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 1
    php_value session.cookie_samesite "Lax"
</IfModule>

# =============================================================================
# Compression
# =============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# =============================================================================
# Cache Control (static assets — templates, images)
# =============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
</IfModule>
