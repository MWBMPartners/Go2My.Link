# =============================================================================
# Go2My.Link — .htaccess for Admin Dashboard (admin.go2my.link)
# =============================================================================
#
# Handles: HTTPS enforcement, security headers, private directory blocking,
#          clean URLs (no .php extension), URL routing to index.php
#
# Mirrors the Component A .htaccess with minor route differences.
#
# @package    Go2My.Link
# @subpackage Configuration
# @author     MWBM Partners Ltd (MWservices)
# @version    0.5.0
# @since      Phase 4
# =============================================================================

# =============================================================================
# Enable Rewrite Engine
# https://httpd.apache.org/docs/2.4/mod/mod_rewrite.html
# =============================================================================
RewriteEngine On

# =============================================================================
# HTTPS Enforcement
# Redirect all HTTP traffic to HTTPS (301 Permanent)
# https://httpd.apache.org/docs/2.4/rewrite/avoid.html
# =============================================================================
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# =============================================================================
# Security Headers
# https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers
# =============================================================================
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Clickjacking protection — allow framing from same origin only
    Header set X-Frame-Options "SAMEORIGIN"

    # XSS protection (legacy browsers)
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy — send origin only for cross-origin requests
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy — disable unused browser APIs
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"

    # Content Security Policy
    # frame-src 'self' explicitly allows the OWN-PAGE-preview <iframe srcdoc>
    # (pages/linkspage/preview/index.php, #47) — the framed document is
    # always fully sandboxed (sandbox="", no allow-scripts) so this does not
    # widen script execution; it only lets the admin dashboard frame its own
    # already-escaped, static-HTML preview content.
    # 📖 Reference: https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' cdn.jsdelivr.net cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' cdn.jsdelivr.net cdnjs.cloudflare.com; font-src 'self' cdnjs.cloudflare.com data:; img-src 'self' data: https:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

    # HSTS — enforce HTTPS for 1 year
    # 📖 Reference: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Strict-Transport-Security
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Keep dashboard pages out of search results. Every page here is behind a
    # login, so there is nothing for a search engine to index. robots.txt asks
    # crawlers not to visit; this header tells them not to list anything they
    # do reach.
    # 📖 Reference: https://developers.google.com/search/docs/crawling-indexing/robots-meta-tag
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# =============================================================================
# Block Access to Private Directories
# Directories prefixed with _ are not web-accessible.
# Returns 403 Forbidden for any request to these paths.
# =============================================================================
RewriteRule ^\.auth(/|$) - [F,L]
RewriteRule ^_includes(/|$) - [F,L]
RewriteRule ^_functions(/|$) - [F,L]
RewriteRule ^_libraries(/|$) - [F,L]
RewriteRule ^_uploads(/|$) - [F,L]
RewriteRule ^_backups(/|$) - [F,L]
RewriteRule ^_sql(/|$) - [F,L]
RewriteRule ^_schemas(/|$) - [F,L]

# =============================================================================
# Block Direct Requests to Page Files — /pages/ (#285)
# The files under pages/ are page fragments: pieces of a page that the front
# controller (index.php) puts between the header and the footer. They are
# included by PHP, they are not web addresses. Opened on their own, a dashboard
# page stopped with a blank 500 error and a PHP fatal error in the log.
#
# So a request for /pages/ or anything under it is answered with 404. The
# "ErrorDocument 404" line further down sends that answer to the front
# controller, which shows the normal branded 404 page to a signed-in visitor,
# as for any other unknown dashboard address (a visitor who is not signed in is
# sent to the sign-in page first, as for every dashboard address). The front
# controller's own use of these files is a PHP include, not a request over the
# web, so this rule does not affect it.
# The answer is given here, rather than by rewriting to the front controller,
# because a rewrite of a folder address that has no trailing slash (/pages/links)
# first made Apache redirect to the same address with a slash added and the
# route name in the query string.
# This rule has to stay above the "Clean URLs" rule below, or a request such as
# /pages/home would be rewritten to the file pages/home.php first.
# =============================================================================
RewriteRule ^pages(/|$) - [R=404,L]

# =============================================================================
# Block Access to Sensitive Files
# =============================================================================
<FilesMatch "\.(env|log|sql|bak|old|ini|sh|conf|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block .htaccess itself and other dot-files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# =============================================================================
# Directory Listing Protection
# Prevent browsing of directory contents
# https://httpd.apache.org/docs/2.4/mod/core.html#options
# =============================================================================
Options -Indexes

# =============================================================================
# Clean URLs — Remove .php Extension
# Rewrites /page to /page.php if the file exists
# https://httpd.apache.org/docs/2.4/rewrite/remapurl.html
# =============================================================================

# If the request is not a file and not a directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Check if a .php file exists for the request
RewriteCond %{REQUEST_FILENAME}.php -f

# Rewrite to the .php file (internally, no redirect)
RewriteRule ^(.+)$ $1.php [L]

# =============================================================================
# URL Routing — Route to index.php
# Catches all remaining requests and routes them via the ?route= parameter.
# Actual files and directories are served directly (handled by conditions above).
# =============================================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# =============================================================================
# Character Encoding
# =============================================================================
AddDefaultCharset UTF-8

# =============================================================================
# Error Documents
# Custom branded error pages (routed through index.php for full template).
# The front controller shows the main site's error page files for these
# four routes, inside the dashboard layout.
# =============================================================================
ErrorDocument 400 /index.php?route=errors/400
ErrorDocument 403 /index.php?route=errors/403
ErrorDocument 404 /index.php?route=errors/404
ErrorDocument 500 /index.php?route=errors/500

# =============================================================================
# PHP Configuration (if supported by hosting)
# =============================================================================
<IfModule mod_php.c>
    # Display errors off in production
    php_flag display_errors Off
    php_flag log_errors On

    # Session security
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 1
    php_value session.cookie_samesite "Lax"
    php_value session.use_strict_mode 1
</IfModule>

# =============================================================================
# Compression (if mod_deflate is available)
# https://httpd.apache.org/docs/2.4/mod/mod_deflate.html
# =============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# =============================================================================
# Cache Control (static assets)
# https://httpd.apache.org/docs/2.4/mod/mod_expires.html
# =============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
</IfModule>
