# Installer directory — DELETE this entire directory after a successful install.

# Serve the installer directly: disable the front-controller rewrite for this dir.
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

DirectoryIndex index.php

# Keep the installer out of search engines.
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# No directory listing.
Options -Indexes
