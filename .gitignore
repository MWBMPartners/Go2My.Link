# ============================================================================
# 🚫 Go2My.Link — .gitignore
# ============================================================================
# Tailored for PHP/MySQL development on macOS, Windows & Linux (incl. Debian/Raspberry Pi)
# IDE: Visual Studio Code (with FTP Sync extension) & Xcode
# Hosting: Dreamhost Shared Hosting
#
# This file is dynamically maintained as the project evolves.
# ============================================================================

# ============================================================================
# 🔐 Sensitive Credentials & Secrets
# ============================================================================
# Auth credentials files contain database passwords, encryption keys,
# and third-party API secrets. These MUST NEVER be committed.
# Template files (auth_creds.example.php) ARE tracked for reference.
# ============================================================================
**/auth_creds.php
!**/auth_creds.example.php

# Legacy MWlink config holds a plaintext DB credential — never commit it, and
# never commit the legacy web root it lives in (it must not ship). See #93.
**/dbConfig.php
**/public_html_legacy/

# Installer runtime artefacts (server-local; never commit)
# The shared server-wide credentials dir stays "_auth_keys/"; each
# component's own credential-override dir was renamed from "_auth_keys/" to
# ".auth/". Both patterns are kept so a lock/token file is ignored regardless
# of which directory it ends up in.
**/_auth_keys/.install_token
**/_auth_keys/.installed
**/.auth/.install_token
**/.auth/.installed

# dev-team autopilot loop lock (runtime only; state file autopilot.json IS tracked)
.dev-team/loop.lock/

# MaxMind GeoLite2 database (#43) — a large, licensed, frequently-updated
# binary. NEVER committed; fetched at DEPLOY time by scripts/fetch-geoip.sh
# (see .github/workflows/sftp-deploy.yml). The vendored PURE-PHP READER
# library that reads this file (web/_libraries/maxminddb/*.php) IS tracked —
# only the .mmdb data file itself is excluded here.
*.mmdb

*.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx

# ============================================================================
# 🖥️ Operating System Files
# ============================================================================

# macOS
# 📖 https://support.apple.com/en-gb/guide/mac-help/mh40593/mac
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
__MACOSX/

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux (including Debian-based / Raspberry Pi OS)
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*
core
*.core
.crash

# ============================================================================
# 💻 IDE & Editor Files
# ============================================================================

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace
.history/

# VS Code on Linux / Remote Development (SSH to Raspberry Pi, etc.)
# 📖 https://code.visualstudio.com/docs/remote/ssh
.vscode-server/
.vscode-oss/

# ============================================================================
# 🤖 Claude Code (portable context is committed; machine-local settings are not)
# ============================================================================
# `.claude/settings.local.json` holds per-machine/per-user Claude Code settings
# (permissions, local overrides). The shared `.claude/settings.json` IS tracked.
.claude/settings.local.json
*.vsix

# Visual Studio
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xccheckout
*.moved-aside
DerivedData/
*.hmap

# JetBrains IDEs (PhpStorm, WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
Session.vim
.netrwhist

# ============================================================================
# 📂 FTP Sync Extension (Visual Studio Code)
# ============================================================================
# The ftp-sync.json file contains FTP/SFTP credentials and should
# NEVER be committed to version control.
# 📖 https://marketplace.visualstudio.com/items?itemName=lukasz-wronski.ftp-sync
# ============================================================================
ftp-sync.json
.ftp-sync.json
sftp.json
.sftp/

# ============================================================================
# 🐘 PHP
# ============================================================================
# 📖 https://www.php.net/manual/en/

# Composer (not used on Dreamhost shared hosting, but included for safety)
/vendor/
composer.lock

# PHP-CS-Fixer
.php-cs-fixer.cache
.php_cs.cache

# PHPUnit
.phpunit.result.cache
.phpunit.cache/

# PHP error logs (local development)
php_errors.log
error_log

# ============================================================================
# 🗄️ Database
# ============================================================================

# SQL dump archive (large files, stored locally only)
.sql/_archive/

# Database backup files
*.sql.gz
*.sql.bz2
*.sql.zip

# ============================================================================
# 📦 Uploads, Backups & Generated Content
# ============================================================================
# These directories exist in the repo structure (via .gitkeep) but their
# CONTENTS should not be tracked — they contain user uploads, backups,
# and other generated/transient files.
# ============================================================================
**/_uploads/*
!**/_uploads/.gitkeep

**/_backups/*
!**/_backups/.gitkeep

# ============================================================================
# 📚 Third-Party Libraries (Self-Hosted)
# ============================================================================
# Libraries downloaded for local/CDN fallback hosting.
# These are large and can be re-downloaded; tracked via README.md instead.
# Uncomment the lines below if you prefer NOT to track them in git.
# ============================================================================
# web/_libraries/*
# !web/_libraries/.gitkeep
# !web/_libraries/README.md
# **/web/Go2My.Link/_libraries/*
# **/web/G2My.Link/_libraries/*
# **/web/Lnks.page/_libraries/*

# ============================================================================
# 🏗️ Build & Dependency Artifacts
# ============================================================================
node_modules/
bower_components/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/

# ============================================================================
# 🧪 Testing & Coverage
# ============================================================================
coverage/
.nyc_output/
*.lcov

# ============================================================================
# 🤖 AI Assistant Context
# ============================================================================
# Claude and OpenAI context directories ARE tracked (they contain
# project briefs, plans, and memory files useful across sessions).
# Only exclude session-specific transcript logs.
# ============================================================================
#*.jsonl

# ============================================================================
# 📄 Miscellaneous
# ============================================================================
*.tmp
*.temp
*.bak
*.backup
*.orig
*.patch
*.diff

# Local History for Visual Studio Code
.sql/.archive/

# MacOS Finder metadata files
.DS_Store
