out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
Session.vim
.netrwhist

# ============================================================================
# 📂 FTP Sync Extension (Visual Studio Code)
# ============================================================================
# The ftp-sync.json file contains FTP/SFTP credentials and should
# NEVER be committed to version control.
# 📖 https://marketplace.visualstudio.com/items?itemName=lukasz-wronski.ftp-sync
# ============================================================================
ftp-sync.json
.ftp-sync.json
sftp.json
.sftp/

# ============================================================================
# 🐘 PHP
# ============================================================================
# 📖 https://www.php.net/manual/en/

# Composer (not used on Dreamhost shared hosting, but included for safety)
/vendor/
composer.lock

# PHP-CS-Fixer
.php-cs-fixer.cache
.php_cs.cache

# PHPUnit
.phpunit.result.cache
.phpunit.cache/

# PHP error logs (local development)
php_errors.log
error_log

# ============================================================================
# 🗄️ Database
# ============================================================================

# SQL dump archive (large files, stored locally only)
.sql/_archive/

# Database backup files
*.sql.gz
*.sql.bz2
*.sql.zip

# ============================================================================
# 📦 Uploads, Backups & Generated Content
# ============================================================================
# These directories exist in the repo structure (via .gitkeep) but their
# CONTENTS should not be tracked — they contain user uploads, backups,
# and other generated/transient files.
# ============================================================================
**/_uploads/*
!**/_uploads/.gitkeep

**/_backups/*
!**/_backups/.gitkeep

# ============================================================================
# 📚 Third-Party Libraries (Self-Hosted)
# ============================================================================
# Libraries downloaded for local/CDN fallback hosting.
# These are large and can be re-downloaded; tracked via README.md instead.
# Uncomment the lines below if you prefer NOT to track them in git.
# ============================================================================
# web/_libraries/*
# !web/_libraries/.gitkeep
# !web/_libraries/README.md
# **/web/Go2My.Link/_libraries/*
# **/web/G2My.Link/_libraries/*
# **/web/Lnks.page/_libraries/*

# ============================================================================
# 🏗️ Build & Dependency Artifacts
# ============================================================================
node_modules/
bower_components/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/

# ============================================================================
# 🧪 Testing & Coverage
# ============================================================================
coverage/
.nyc_output/
*.lcov

